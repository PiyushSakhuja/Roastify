# --- Spotify (required) ---
# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# --- AI Providers (at least ONE required) ---
# You can set as many as you like. If you don't request a specific
# provider from the frontend, the server tries them in this order:
# Groq -> Mistral -> Gemini, falling back automatically if one fails.
# All three have a free tier as of writing.

# Groq (free tier, Llama models, very fast): https://console.groq.com/keys
GROQ_API_KEY=
# Optional override, defaults to llama-3.3-70b-versatile
GROQ_MODEL=

# Mistral AI (free tier via La Plateforme): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Optional override, defaults to mistral-small-latest
MISTRAL_MODEL=

# Google Gemini (free tier via AI Studio): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Steam (optional — required only for the Steam Roast integration) ---
# Get a key at: https://steamcommunity.com/dev/apikey
# Kept server-side only; never exposed to the frontend.
STEAM_API_KEY=

# --- Server config ---
# Comma-separated list of origins allowed to call this backend.
# For local dev this is usually http://localhost:8888
# For production, set this to your deployed frontend URL(s).
ALLOWED_ORIGINS=http://localhost:8888

# Port the server listens on. Most hosts (Render, Railway, Heroku) inject
# this automatically — only override for local dev if you want a different port.
PORT=8888
# --- GitHub (optional — enables the GitHub roast integration) ---
# GitHub OAuth App settings: https://github.com/settings/developers
# Set the app's "Authorization callback URL" to your frontend's
# /github-roast route, e.g. http://localhost:5173/github-roast for local dev.
# If these are unset, GitHub routes return 503 and Spotify still works fine.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Trakt (optional — required only for the Movie Roast integration) ---
# Create an app at: https://trakt.tv/oauth/applications
# Only the Client ID is needed — Movie Roast only reads *public* Trakt
# profiles (watched history, ratings), which requires no user OAuth.
# Kept server-side only; never exposed to the frontend.
TRAKT_CLIENT_ID=

# --- Riot Games / VALORANT (optional — required only for VALORANT Roast) ---
# Register an app at https://developer.riotgames.com/ and request RSO
# (Riot Sign On) product access for player-authorized data.
# All four of these must be set for the real integration to activate;
# otherwise VALORANT Roast reports itself as "being configured."
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
RIOT_API_KEY=
# Must exactly match the redirect URI registered with your Riot RSO app,
# and point at this backend's callback route, e.g.
# https://your-backend.example.com/api/valorant/callback
RIOT_RSO_REDIRECT_URI=
# Continental cluster used for Riot Account API calls: americas | europe | asia
RIOT_API_CLUSTER=americas
# "riot" (default) uses the real Riot RSO + API flow above.
# "mock" serves clearly-labeled synthetic data for local UI development only
# — never mixed with real player data, never used unless explicitly set.
VALORANT_PROVIDER=riot
# Base URL of the deployed frontend, used to build the redirect back to
# /valorant-roast after the Riot OAuth callback.
FRONTEND_URL=http://localhost:5173