# Copy to .env (local dev) or .env.production (prod build), or set these
# as environment variables in your host's dashboard (Vercel/Netlify/etc).
# Vite only exposes vars prefixed with VITE_ to the browser bundle — this
# is safe, these are meant to be public (same trust level as OAuth client IDs).

# Your deployed Roastify backend URL. No trailing slash.
# Local dev default (if unset): http://localhost:8888
VITE_BACKEND_URL=https://your-backend.example.com

# Your GitHub OAuth App's Client ID (public — safe to expose).
# Register at: https://github.com/settings/developers
# Callback URL must be set to <your-frontend-url>/github-roast
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
